---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;

function wrapTitle(text: string, maxChars: number) {
  const words = text.replace(/\s+/g, " ").trim().split(" ");
  const lines: string[] = [];
  let line = "";
  for (const word of words) {
    const next = line ? `${line} ${word}` : word;
    if (next.length > maxChars && line) {
      lines.push(line);
      line = word;
    } else {
      line = next;
    }
  }
  if (line) lines.push(line);
  return lines.slice(0, 5);
}

const lines = wrapTitle(title, 22);
const fontSize = lines.length >= 5 ? 52 : lines.length === 4 ? 58 : 68;
const lineHeight = Math.round(fontSize * 1.2);
const startY = 200;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1200 630"
  width="1200"
  height="630"
  aria-hidden="true"
  class:list={["block h-auto max-w-full", className]}
>
  <rect width="1200" height="630" fill="#3b0764"></rect>
  <rect width="1200" height="16" fill="#4d7c0f"></rect>
  <text
    x="72"
    y="108"
    fill="#e9d5ff"
    font-family="ui-sans-serif, system-ui, sans-serif"
    font-size="28"
    font-weight="600">Diego Hernandez</text
  >
  {
    lines.map((line, index) => (
      <text
        x="72"
        y={startY + index * lineHeight}
        fill="#ffffff"
        font-family="ui-sans-serif, system-ui, sans-serif"
        font-size={fontSize}
        font-weight="700"
      >
        {line}
      </text>
    ))
  }
</svg>
