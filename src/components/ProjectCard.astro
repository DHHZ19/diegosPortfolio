---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { projectImage } from "../lib/project-images";
import GatewayCover from "./GatewayCover.astro";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { title, category, problem, whatIBuilt, stack, status, cover, links } =
  project.data;
const headingId = project.id;
const image = cover.kind === "image" ? projectImage(cover.src) : undefined;

if (cover.kind === "image" && !image) {
  throw new Error(
    `Project "${title}" points at "${cover.src}", but that file is not in src/assets/projects/.`,
  );
}

const linkClass = {
  solid:
    "inline-flex min-h-11 items-center gap-1 rounded-full px-5 py-2 font-semibold transition bg-zinc-900 text-white hover:bg-lime-700 dark:bg-zinc-100 dark:text-zinc-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600",
  outline:
    "inline-flex min-h-11 items-center gap-1 rounded-full px-5 py-2 font-semibold transition border border-zinc-900 text-zinc-900 hover:border-lime-700 hover:text-lime-700 dark:border-zinc-200 dark:text-zinc-100 dark:hover:border-lime-500 dark:hover:text-lime-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600",
};
---

<article
  class:list={[
    "grid min-w-0 items-center gap-6 md:grid-cols-2 md:gap-12",
    index % 2 === 1 && "md:[&>*:first-child]:order-2",
  ]}
  aria-labelledby={headingId}
>
  {
    cover.kind === "gateway" ? (
      <GatewayCover
        line={cover.line}
        caption={cover.caption}
        badge={cover.badge}
        label={`Illustration for ${title}`}
      />
    ) : (
      image && (
        <Image
          src={image}
          alt={cover.alt}
          width={1280}
          height={720}
          class="aspect-video w-full min-w-0 rounded-2xl object-cover object-top ring-1 ring-black/5 dark:ring-white/10"
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      )
    )
  }
  <div class="min-w-0 text-center md:text-left">
    <p
      class="text-sm font-medium uppercase tracking-widest text-zinc-500 dark:text-zinc-400"
    >
      {category}
    </p>
    <h2
      id={headingId}
      class="mt-1 text-balance text-[1.75rem] font-bold leading-tight text-zinc-900 dark:text-zinc-50 sm:text-4xl"
    >
      {title}
    </h2>
    <dl class="mx-auto mt-5 max-w-md space-y-4 text-left md:mx-0">
      <div class="border-l-4 border-lime-700 pl-4 dark:border-lime-500">
        <dt
          class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400"
        >
          Problem
        </dt>
        <dd class="mt-1 text-lg text-zinc-800 dark:text-zinc-200">{problem}</dd>
      </div>
      <div class="border-l-4 border-stone-300 pl-4 dark:border-zinc-700">
        <dt
          class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400"
        >
          What I built
        </dt>
        <dd class="mt-1 text-lg text-zinc-800 dark:text-zinc-200">
          {whatIBuilt}
        </dd>
      </div>
      <div class="border-l-4 border-stone-300 pl-4 dark:border-zinc-700">
        <dt
          class="text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400"
        >
          Stack
        </dt>
        <dd class="mt-1 text-lg text-zinc-800 dark:text-zinc-200">{stack}</dd>
      </div>
    </dl>
    {
      links.length > 0 && (
        <div class="mt-6 flex flex-wrap justify-center gap-3 md:justify-start">
          {links.map((link) => {
            const external = /^https?:\/\//.test(link.href);
            return (
              <a
                href={link.href}
                class={linkClass[link.style]}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </div>
      )
    }
    {
      status && (
        <p class="mt-5 text-sm font-semibold uppercase tracking-widest text-lime-700 dark:text-lime-500">
          {status}
        </p>
      )
    }
  </div>
</article>
