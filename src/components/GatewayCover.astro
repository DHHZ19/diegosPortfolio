---
interface Props {
  line: string;
  caption: string;
  badge?: string;
  label: string;
}

const { line, caption, badge, label } = Astro.props;
---

<div
  class="relative flex aspect-video w-full min-w-0 flex-col items-center justify-center gap-3 overflow-hidden rounded-2xl bg-[linear-gradient(135deg,#4d7c0f_0%,#27272a_55%,#18181b_100%)] px-4 font-mono text-lime-100 ring-1 ring-black/5 dark:ring-white/10"
  role="img"
  aria-label={label}
>
  <span
    class="text-balance text-center text-lg font-bold tracking-tight sm:text-2xl"
  >
    {line}
  </span>
  <span class="text-center text-sm text-lime-200/70 sm:text-base"
    >{caption}</span
  >
  {
    badge && (
      <span class="absolute right-3 top-3 rounded-full bg-lime-400 px-3 py-1 font-sans text-xs font-bold uppercase tracking-widest text-zinc-900">
        {badge}
      </span>
    )
  }
</div>
