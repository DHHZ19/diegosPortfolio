---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
import { coverFor } from "../lib/covers";

type Props = CollectionEntry<"blog">["data"];

const posts = (await getCollection("blog")).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const hero = coverFor(heroImage);
const pageTitle = `${title} | ${SITE_TITLE}`;
const otherPosts = posts.filter((post) => post.data.title !== title);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} type="article" />
    <meta name="author" content="Diego Hernandez" />
    <style>
      hr {
        border-top: 1px solid #ddd;
        margin: 1rem 0;
      }
      .last-updated-on {
        font-style: italic;
      }
      /* Match the live prose column (65ch) and the w-5/6 padded cards.
         :global because these classes land on Astro's Image output. */
      :global(.blog-hero) {
        display: block;
        width: 100%;
        max-width: 65ch;
        height: auto;
      }
      :global(.blog-other-image) {
        width: calc(min(65ch, 100vw) * 5 / 6 - 2.25rem);
        height: auto;
      }
    </style>
  </head>

  <script>
    const copyButtonLabel = "Copy Code";

    let blocks = document.querySelectorAll("pre");

    blocks.forEach((block) => {
      block.classList.add("relative");
      if (navigator.clipboard) {
        let button = document.createElement("button");
        button.classList.add(
          "copy-button",
          "block",
          "absolute",
          "top-0",
          "right-0",
          "py-2",
          "px-4",
        );
        button.type = "button";
        button.innerText = copyButtonLabel;
        block.appendChild(button);

        button.addEventListener("click", async () => {
          await copyCode(block, button);
        });
      }
    });

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code.innerText;

      await navigator.clipboard.writeText(text);

      button.innerText = "Code Copied!";
      button.classList.add("text-md", "text-green-300");

      setTimeout(() => {
        button.innerText = copyButtonLabel;
        button.classList.remove("text-md", "text-green-300");
      }, 800);
    }
  </script>
  <body
    class="min-h-screen bg-[#f5f5f5] text-base dark:bg-[color:var(--darkmode-color)] dark:text-white"
  >
    <Header />
    <main class="mx-auto flex w-full max-w-3xl flex-col px-5">
      <article>
        {
          hero && (
            <Image
              src={hero}
              width={hero.width}
              height={hero.height}
              alt=""
              loading="eager"
              decoding="async"
              class="blog-hero mt-6"
            />
          )
        }
        <h1 class="mt-6 text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
        <p class="mt-2 text-neutral-700 dark:text-neutral-300">
          <FormattedDate date={pubDate} />
        </p>
        {
          updatedDate && (
            <p class="last-updated-on text-sm text-neutral-700 dark:text-neutral-300">
              Last updated on <FormattedDate date={updatedDate} />
            </p>
          )
        }
        <hr />
        <div class="prose dark:prose-invert max-w-none text-lg">
          <slot />
        </div>
      </article>
      <section class="pb-4 pt-12" aria-labelledby="other-posts-heading">
        <h2 id="other-posts-heading" class="text-center text-[1.375rem] font-bold">
          Other posts
        </h2>
        <ul class="mt-6 flex list-none flex-col gap-4 p-0">
          {
            otherPosts.map((post) => {
              const cover = coverFor(post.data.heroImage);
              return (
                <li class="rounded-2xl border-2 border-zinc-300 p-4 dark:border-zinc-700">
                  <a href={`/blog/${post.id}/`} class="block">
                    {cover && (
                      <Image
                        src={cover}
                        alt=""
                        width={cover.width}
                        height={cover.height}
                        class="blog-other-image rounded-2xl"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <span class="mt-3 block text-xl font-semibold">{post.data.title}</span>
                  </a>
                  <p class="mt-2 text-base">{post.data.description}</p>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
