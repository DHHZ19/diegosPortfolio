---
import MySiteLayout from "../layouts/IndexLayout.astro";
import { Image } from "astro:assets";
import { SITE_DESCRIPTION, SITE_ROLE, SITE_TITLE } from "../consts";
import SocialLinks from "../components/SocialLinks.astro";
import avatar from "../assets/profilepic.png";
---

<MySiteLayout
  title={`${SITE_TITLE} | ${SITE_ROLE}`}
  description={SITE_DESCRIPTION}
>
  <section class="mx-auto w-full max-w-3xl px-5 pb-2 pt-8 lg:px-12">
    <div class="flex items-start gap-4">
      <Image
        src={avatar}
        alt="Portrait of Diego Hernandez"
        width={192}
        height={192}
        class="h-16 w-16 shrink-0 rounded-full border-2 border-purple-600 object-cover sm:h-24 sm:w-24"
        loading="eager"
        decoding="async"
      />
      <div class="min-w-0">
        <h1
          class="text-3xl font-bold tracking-tight md:text-[2.375rem] md:leading-tight"
        >
          {SITE_TITLE}, {SITE_ROLE}
        </h1>
        <p class="mt-4 max-w-xl text-lg tracking-tight">
          Loves problem solving, always seeking new challenges, outdoors
          enjoyer. I share my development journey through <a
            class="font-semibold underline decoration-purple-600 hover:[text-shadow:0_0_5px_#ffffff]"
            href="https://www.diegohdev.com/blog/">technical articles</a
          > and projects.
        </p>
      </div>
    </div>
    <nav class="mt-8" aria-label="Social profiles">
      <SocialLinks labelled />
    </nav>
  </section>
  <section class="mx-auto mt-12 w-full max-w-3xl px-5 lg:px-12">
    <h2 class="text-2xl/snug font-bold">Currently</h2>
    <ul class="mt-2.5 space-y-2.5 text-lg">
      <li>Full Stack Dev at UsBank</li>
    </ul>
  </section>
  <section class="mx-auto mt-10 w-full max-w-3xl px-5 pb-4 lg:px-12">
    <h2 class="text-2xl/snug font-bold">Previously</h2>
    <ul class="mt-2.5 space-y-2.5 text-lg">
      <li>Developer at Impel AI</li>
      <li>Web Developer at NCXT</li>
      <li>Software Engineer at 100Devs</li>
      <li>Freelance Dev</li>
    </ul>
  </section>
</MySiteLayout>
