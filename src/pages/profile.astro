---
import { Image } from "astro:assets";
import avatar from "../assets/profilepic.png";
import BaseHead from "../components/BaseHead.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_DESCRIPTION, SITE_ROLE, SITE_TITLE } from "../consts";

const PAGE_TITLE = "Profile";
const year = new Date().getFullYear();

interface ProfileLink {
  title: string;
  href: string;
  featured?: boolean;
}

const LINKS: ProfileLink[] = [
  { title: "Website", href: "/", featured: true },
  { title: "LinkedIn", href: "https://linkedin.com/in/diegohernandezcode" },
  { title: "X", href: "https://twitter.com/DiegoCode_" },
  { title: "Blog", href: "/blog/" },
  { title: "GitHub", href: "https://github.com/DHHZ19" },
  { title: "Bluesky", href: "https://bsky.app/profile/diegohdev.com" },
];

const linkClass =
  "flex w-full items-center justify-center rounded-lg border px-6 py-4 text-center text-lg font-semibold shadow-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600";
const featuredClass =
  "border-purple-600 bg-purple-600 text-white hover:border-purple-700 hover:bg-purple-700";
const plainClass =
  "border-stone-300 bg-white text-zinc-900 hover:border-purple-600 hover:bg-purple-600 hover:text-white dark:border-stone-600 dark:bg-stone-800 dark:text-stone-50 dark:hover:border-purple-600 dark:hover:bg-purple-600 dark:hover:text-white";

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${PAGE_TITLE} | ${SITE_TITLE} | ${SITE_ROLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body
    class="relative flex min-h-screen w-full flex-col bg-[#f5f5f5] text-base dark:bg-[color:var(--darkmode-color)] dark:text-white"
  >
    <div class="absolute top-3 right-3 z-10 sm:top-4 sm:right-6">
      <ThemeToggle />
    </div>
    <main class="flex w-full flex-1 flex-col">
      <div class="mx-auto my-auto w-full max-w-xl px-5 py-16 text-center">
        <Image
          src={avatar}
          alt="Portrait of Diego Hernandez"
          class="mx-auto h-24 w-24 rounded-full border-2 border-purple-600 object-cover"
          width={192}
          height={192}
          loading="eager"
          decoding="async"
        />

        <p
          class="mt-6 text-sm font-semibold tracking-[0.2em] text-lime-700 uppercase dark:text-lime-500"
        >
          {SITE_ROLE}
        </p>
        <h1
          class="mt-2 text-4xl font-extrabold tracking-tight text-balance text-zinc-800 sm:text-5xl dark:text-zinc-100"
        >
          {SITE_TITLE}
        </h1>
        <p
          class="mx-auto mt-4 max-w-lg text-lg text-balance text-zinc-600 dark:text-zinc-300"
        >
          {SITE_ROLE} · AI & security · Full Stack Dev at U.S. Bank
        </p>

        <nav class="mx-auto mt-8 w-full max-w-sm" aria-label="Profile links">
          <ul class="flex flex-col gap-3">
            {
              LINKS.map((link) => {
                const external = isExternal(link.href);
                return (
                  <li>
                    <a
                      class:list={[
                        linkClass,
                        link.featured ? featuredClass : plainClass,
                      ]}
                      href={link.href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noopener noreferrer" : undefined}
                    >
                      {link.title}
                      {external && (
                        <span class="sr-only"> (opens in new tab)</span>
                      )}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        <p class="mt-10 text-sm text-zinc-600 dark:text-zinc-400">
          &copy; {year}
          {SITE_TITLE}
        </p>
      </div>
    </main>
  </body>
</html>
