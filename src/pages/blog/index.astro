---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { coverFor } from "../../lib/covers";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      ul li :global(time) {
        font-style: italic;
        color: #3f3f46;
      }
      @media (min-width: 768px) {
        ul li :global(time) {
          flex: 0 0 130px;
        }
      }
      :global(html.dark) ul li :global(time) {
        color: #d4d4d8;
      }
    </style>
  </head>
  <body
    class="min-h-screen w-full bg-[#f5f5f5] text-base dark:bg-[color:var(--darkmode-color)] dark:text-white"
  >
    <Header />
    <main class="w-full">
      <header class="mx-auto w-full max-w-3xl px-5 pt-8">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 md:text-[2.375rem] md:leading-tight">
          Writing on software development, beginner friendly.
        </h1>
        <p class="mt-6 text-lg text-zinc-700 dark:text-zinc-300">
          Tutorials on projects like AI, Web development, backend
          development. As well as explanations on concepts like data
          structures & algorithms all collected in chronological order.
        </p>
      </header>
      <section class="mx-auto mt-12 w-full max-w-3xl border-t border-stone-300 px-5 pt-2">
        <ul class="flex flex-col md:items-center">
          {
            posts.map((post, idx) => {
              const cover = coverFor(post.data.heroImage);
              return (
                <li class="mt-12 flex w-full max-w-3xl flex-col items-start md:w-2/3 md:flex-row md:flex-nowrap md:items-start md:justify-center">
                  <FormattedDate
                    class="pl-2 md:shrink-0 md:whitespace-nowrap md:pl-0"
                    date={post.data.pubDate}
                  />
                  <a
                    href={`/blog/${post.id}/`}
                    class="w-56 rounded-sm py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 md:w-full"
                  >
                    <div class="w-56">
                      {cover && (
                        <Image
                          class="w-56 pl-2 py-2"
                          src={cover}
                          width={cover.width}
                          height={cover.height}
                          alt=""
                          loading={idx < 2 ? "eager" : "lazy"}
                          decoding="async"
                        />
                      )}
                      <h2 class="pl-2 pt-1 text-xl font-bold leading-snug">{post.data.title}</h2>
                      <p class="p-2 text-base text-neutral-700 dark:text-neutral-300">
                        {post.data.description}
                      </p>
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
