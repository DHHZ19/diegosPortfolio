---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import PostCover from "../../components/PostCover.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      ul li :global(time) {
        font-style: italic;
        color: #3f3f46;
      }
      :global(html.dark) ul li :global(time) {
        color: #d4d4d8;
      }
    </style>
  </head>
  <body
    class="min-h-screen w-full bg-[#f5f5f5] text-base dark:bg-[color:var(--darkmode-color)] dark:text-white"
  >
    <Header />
    <main class="w-full">
      <header class="mx-auto w-full max-w-3xl px-5 pt-8">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 md:text-[2.375rem] md:leading-tight">
          Writing on software development, beginner friendly.
        </h1>
        <p class="mt-6 text-lg text-zinc-700 dark:text-zinc-300">
          Tutorials on projects like AI, Web development, backend
          development. As well as explanations on concepts like data
          structures & algorithms all collected in chronological order.
        </p>
      </header>
      <section class="mx-auto mt-12 w-full max-w-3xl border-t border-stone-300 px-5 pt-2">
        <ul class="flex flex-col">
          {
            posts.map((post) => (
              <li class="mt-8">
                <article>
                  <FormattedDate date={post.data.pubDate} />
                  <h2 class="mt-2 text-xl font-bold leading-snug">
                    <a
                      href={`/blog/${post.id}/`}
                      class="rounded-sm hover:text-purple-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600"
                    >
                      {post.data.title}
                    </a>
                  </h2>
                  <PostCover title={post.data.title} class="mt-3 w-full rounded-xl" />
                  <p class="mt-3 text-base text-neutral-700 dark:text-neutral-300">
                    {post.data.description}
                  </p>
                </article>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
