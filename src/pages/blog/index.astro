---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import insertionSortCover from "../../assets/blog/insertion-sort.png";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { coverFor } from "../../lib/covers";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Column is max-w-2xl (672px) with px-5, so the cover is at most 632px wide.
const coverWidths = [480, 768, 1280];
const coverSizes = "(min-width: 672px) 632px, calc(100vw - 2.5rem)";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body
    class="min-h-screen w-full bg-[#f5f5f5] text-base dark:bg-[color:var(--darkmode-color)] dark:text-white"
  >
    <Header />
    <main class="w-full">
      <header class="mx-auto w-full max-w-2xl px-5 pt-8 text-center">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-lime-700 dark:text-lime-500"
        >
          Blog
        </p>
        <h1
          class="mt-2 text-balance text-3xl font-extrabold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-4xl"
        >
          Writing on software development, beginner friendly.
        </h1>
        <p
          class="mx-auto mt-4 max-w-xl text-pretty text-lg text-zinc-600 dark:text-zinc-300"
        >
          Tutorials on AI, web and backend development, plus data structures &
          algorithms explained, in chronological order.
        </p>
      </header>
      <section
        class="mx-auto mt-10 w-full max-w-2xl border-t border-stone-300 px-5 pt-10 dark:border-zinc-700"
        aria-label="Posts"
      >
        <ul class="flex flex-col gap-14">
          {
            posts.map((post, idx) => {
              const cover = coverFor(post.data.heroImage);
              return (
                <li>
                  <article class="text-center">
                    <a
                      href={`/blog/${post.id}/`}
                      class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600"
                    >
                      {cover ? (
                        <Image
                          src={cover}
                          alt=""
                          width={1280}
                          widths={coverWidths}
                          sizes={coverSizes}
                          quality={
                            cover === insertionSortCover ? 95 : undefined
                          }
                          class="aspect-video w-full rounded-2xl object-cover ring-1 ring-black/5 dark:ring-white/10"
                          loading={idx < 2 ? "eager" : "lazy"}
                          decoding="async"
                        />
                      ) : (
                        <div
                          class="aspect-video w-full rounded-2xl bg-zinc-200 ring-1 ring-black/5 dark:bg-zinc-800 dark:ring-white/10"
                          aria-hidden="true"
                        />
                      )}
                      <FormattedDate
                        class="mt-5 block font-medium uppercase tracking-widest text-zinc-500 dark:text-zinc-400"
                        date={post.data.pubDate}
                      />
                      <h2 class="mt-2 text-balance text-[1.75rem] font-bold leading-tight text-zinc-900 dark:text-zinc-50">
                        {post.data.title}
                      </h2>
                      <p class="mx-auto mt-2 max-w-md text-lg text-zinc-600 dark:text-zinc-300">
                        {post.data.description}
                      </p>
                      <span class="mt-3 inline-block font-semibold text-lime-700 group-hover:underline group-hover:underline-offset-4 dark:text-lime-500">
                        Read post →
                      </span>
                    </a>
                  </article>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
